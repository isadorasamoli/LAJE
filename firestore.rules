rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }
    // 2. Global Helpers
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email.lower() == 'isadorasdml@gmail.com') || 
        (request.auth.token.email != null && request.auth.token.email.lower() == 'isadora.mlima@ufpe.br') || 
        (request.auth.token.email != null && (exists(/databases/$(database)/documents/admins/$(request.auth.token.email)) || exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()))))
      );
    }

    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 3. Validation Blueprint for Response
    function isValidResponse(data) {
      return data.keys().hasAll(['userId', 'email', 'name', 'course', 'leagueRole', 'priority', 'createdAt', 'status'])
        && data.userId is string
        && data.email is string && data.email.size() <= 255
        && data.name is string && data.name.size() <= 255
        && data.course is string && data.course.size() <= 255
        && data.period is string && data.period.size() <= 50
        && (!data.keys().hasAny(['collegeFocus']) || data.collegeFocus is number)
        && data.leagueRole is string && data.leagueRole.size() <= 100
        && (!data.keys().hasAny(['leagueFocus']) || data.leagueFocus is number)
        && (!data.keys().hasAny(['weeklyHours']) || (data.weeklyHours is string && data.weeklyHours.size() <= 200))
        && (!data.keys().hasAny(['roleFocus']) || (data.roleFocus is string && data.roleFocus.size() <= 2000))
        && data.learningFocus is string && data.learningFocus.size() <= 2000
        && data.currentProjects is string && data.currentProjects.size() <= 1000
        && data.interestedProjects is string && data.interestedProjects.size() <= 1000
        && data.priority is string && data.priority.size() <= 50
        && (!data.keys().hasAny(['progress']) || data.progress is number)
        && data.deadline is string && data.deadline.size() <= 50
        && (!data.keys().hasAny(['notifications']) || data.notifications is bool)
        && data.createdAt is number
        && data.status in ['Ativo', 'Ex-membro']
        && (!data.keys().hasAny(['deletionReason']) || (data.deletionReason is string && data.deletionReason.size() <= 2000))
        && (!data.keys().hasAny(['editAuthorized']) || data.editAuthorized is bool)
        && (!data.keys().hasAny(['editRequestStatus']) || data.editRequestStatus is string || data.editRequestStatus == null)
        && (!data.keys().hasAny(['lastEditedAt']) || data.lastEditedAt is number || data.lastEditedAt == null);
    }

    function isValidEvent(data) {
      return data.keys().hasAll(['userId', 'title', 'description', 'duration', 'date', 'createdAt'])
        && data.userId is string
        && data.title is string && data.title.size() <= 255
        && data.description is string && data.description.size() <= 2000
        && data.duration is string && data.duration.size() <= 100
        && data.date is string && data.date.size() <= 50
        && data.createdAt is number;
    }

    function isValidUser(data) {
      return (!data.keys().hasAny(['hasReceivedWelcomeEmail']) || data.hasReceivedWelcomeEmail is bool)
        && (!data.keys().hasAny(['lastEmailSentAt']) || data.lastEmailSentAt is number)
        && (!data.keys().hasAny(['lastEventEndDate']) || data.lastEventEndDate is number)
        && (!data.keys().hasAny(['theme']) || data.theme in ['light', 'dark']);
    }

    function isValidAdmin(data) {
       return data.keys().hasAll(['email'])
         && data.email is string && data.email.size() <= 255;
    }

    // 4. Match Blocks
    match /responses/{responseId} {
      allow read: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      
      allow create: if isSignedIn()
        && isValidId(responseId)
        && incoming().userId == request.auth.uid
        && isValidResponse(incoming());
        
      allow update: if isSignedIn()
        && incoming().userId == existing().userId
        && isValidResponse(incoming())
        && (
           (isAdmin()) ||
           (existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['progress', 'currentProjects'])) ||
           (existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['editRequestStatus'])) ||
           (existing().userId == request.auth.uid && existing().editAuthorized == true)
        );
        
      allow delete: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if isSignedIn(); // All authenticated users can view the calendar
      
      allow create: if isAdmin()
        && isValidId(eventId)
        && incoming().userId == request.auth.uid
        && isValidEvent(incoming());

      allow update: if isAdmin()
        && isValidEvent(incoming());
        
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isSignedIn() && userId == request.auth.uid;
      
      allow create: if isSignedIn()
        && userId == request.auth.uid
        && isValidUser(incoming());
        
      allow update: if isSignedIn()
        && userId == request.auth.uid
        && isValidUser(incoming());
    }

    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
